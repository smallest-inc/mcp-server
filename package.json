{
  "name": "@developer-smallestai/smallest-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for the Smallest AI platform \u2014 manage agents, debug calls, view analytics from your IDE",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallest-inc/mcp-server.git"
  },
  "keywords": [
    "mcp",
    "atoms",
    "voice-agent",
    "ai-agent",
    "smallest"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "smallest-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/http.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"#!/usr/bin/env node\" --packages=external",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "smoke": "npm run build && node smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:http": "tsx src/http.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
